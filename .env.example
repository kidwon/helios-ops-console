# ==============================================================================
# Helios Depot Operations Console: Environment Configuration
# ==============================================================================

# Layer 2: Convex Cloud Reactive Gateway
# When deploying to Convex, run `npx convex dev` to obtain this deployment URL.
# If omitted or left as placeholder, the console automatically runs in high-fidelity
# reactive simulation mode with local WebSocket diff updates.
VITE_CONVEX_URL=https://your-convex-deployment.convex.cloud

# Layer 1: Databricks Lakebase Postgres Credentials
# (These should be configured in your Convex Cloud Dashboard > Settings > Environment Variables,
# NEVER exposed in public client bundles!)
# LAKEBASE_PGHOST=your-lakebase-instance.postgres.database.azure.com
# LAKEBASE_PGPORT=5432
# LAKEBASE_PGDATABASE=databricks_postgres
# LAKEBASE_PGUSER=convex_reader
# LAKEBASE_PGPASSWORD=your_secure_random_password

# Databricks Webhook Secret (for event-driven push on pipeline completion)
# CONVEX_WEBHOOK_SECRET=helios_secret_sync_key_2257
